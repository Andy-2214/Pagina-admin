@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dashboard";

    var porGenero    = ViewBag.PorGenero   as Dictionary<string, int> ?? new();
    var porEdad      = ViewBag.PorEdad     as Dictionary<string, int> ?? new();
    var porDistrito  = ViewBag.PorDistrito as Dictionary<string, int> ?? new();
    var topRutas     = ViewBag.TopRutas;
    var comentPorRuta= ViewBag.ComentariosPorRuta;

    int totalUsuarios   = ViewBag.TotalUsuarios   ?? 0;
    int totalRutas      = ViewBag.TotalRutas       ?? 0;
    int totalBusquedas  = ViewBag.TotalBusquedas   ?? 0;
    int pctCobertura    = ViewBag.PctCobertura     ?? 0;
    int totalComentarios= ViewBag.TotalComentarios ?? 0;

    // género totals for donut
    int genTotal    = porGenero.Values.Sum();
    int genMasc     = porGenero.ContainsKey("masculino") ? porGenero["masculino"]
                    : porGenero.ContainsKey("Masculino") ? porGenero["Masculino"] : 0;
    int genFem      = porGenero.ContainsKey("femenino")  ? porGenero["femenino"]
                    : porGenero.ContainsKey("Femenino")  ? porGenero["Femenino"]  : 0;
    int genOtro     = genTotal - genMasc - genFem;
    double pMasc    = genTotal > 0 ? Math.Round(genMasc  * 100.0 / genTotal, 1) : 0;
    double pFem     = genTotal > 0 ? Math.Round(genFem   * 100.0 / genTotal, 1) : 0;
    double pOtro    = genTotal > 0 ? Math.Round(genOtro  * 100.0 / genTotal, 1) : 0;

    // edad max for bar scale
    int edadMax = porEdad.Values.Any() ? porEdad.Values.Max() : 1;

    // distritos max
    int distMax = porDistrito.Values.Any() ? porDistrito.Values.Max() : 1;

    // donut SVG
    int    svgR  = 40;
    double circ  = 2 * Math.PI * svgR;
}

<style>
    *, *::before, *::after { box-sizing: border-box; }
    :root {
        --bg:      #0D0D1A; --surface: rgba(255,255,255,.05);
        --border:  rgba(255,255,255,.09); --text: #F0EDE8;
        --muted:   rgba(240,237,232,.48); --primary: #F5A623;
        --mono:    'Space Mono', monospace; --main: 'Sora', sans-serif;
        --green:   #3DD68C; --blue: #4A9EFF; --red: #FF6B6B; --purple: #B388FF;
    }
    body { background: var(--bg); font-family: var(--main); color: var(--text); margin: 0; }

    /* ── layout ── */
    .db-wrap { max-width: 1280px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }

    /* ── page header ── */
    .db-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.6rem; }
    .db-eyebrow { font-family: var(--mono); font-size: .65rem; letter-spacing: .18em; text-transform: uppercase; color: var(--primary); margin-bottom: .3rem; }
    .db-title { font-family: var(--mono); font-size: 2rem; font-weight: 700; margin: 0 0 .2rem; }
    .db-sub { font-size: .82rem; color: var(--muted); }
    .db-clock { text-align: right; }
    .db-time { font-family: var(--mono); font-size: 2rem; font-weight: 700; color: var(--primary); }
    .db-date { font-family: var(--mono); font-size: .7rem; color: var(--muted); }

    /* ── divider ── */
    .db-hr { height: 1px; background: linear-gradient(90deg, var(--primary), transparent); margin-bottom: 1.8rem; }

    /* ── KPI row ── */
    .kpi-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border); border-radius: 12px; overflow: hidden; margin-bottom: 1.8rem; }
    .kpi { padding: 1.1rem 1.4rem; display: flex; flex-direction: column; gap: .35rem; }
    .kpi-val { font-family: var(--mono); font-size: 1.9rem; font-weight: 700; line-height: 1; }
    .kpi-lbl { font-size: .68rem; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); }
    .kpi.k-blue   { background: rgba(74,158,255,.13);  } .kpi.k-blue   .kpi-val { color: var(--blue); }
    .kpi.k-green  { background: rgba(61,214,140,.13);  } .kpi.k-green  .kpi-val { color: var(--green); }
    .kpi.k-amber  { background: rgba(245,166,35,.13);  } .kpi.k-amber  .kpi-val { color: var(--primary); }
    .kpi.k-teal   { background: rgba(0,188,212,.13);   } .kpi.k-teal   .kpi-val { color: #00BCD4; }

    /* ── section label ── */
    .sec-lbl { font-family: var(--mono); font-size: .65rem; letter-spacing: .15em; text-transform: uppercase; color: var(--muted); margin-bottom: 1rem; }

    /* ── card ── */
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 1.3rem 1.4rem; }
    .card-title { font-family: var(--mono); font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-bottom: 1rem; display: flex; align-items: center; gap: 6px; }
    .card-title span { width: 7px; height: 7px; border-radius: 50%; background: var(--primary); display: inline-block; }

    /* ── two-col grid ── */
    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.4rem; }

    /* ── route row (búsquedas) ── */
    .route-row { display: flex; align-items: center; justify-content: space-between; padding: .45rem 0; border-bottom: 1px solid var(--border); font-size: .82rem; }
    .route-row:last-child { border-bottom: none; }
    .route-lbl { color: var(--text); }
    .route-cnt { font-family: var(--mono); color: var(--primary); font-size: .8rem; min-width: 32px; text-align: right; }

    /* ── donut ── */
    .donut-wrap { display: flex; align-items: center; gap: 1.2rem; }
    .donut-svg { flex-shrink: 0; }
    .donut-legend { display: flex; flex-direction: column; gap: .6rem; font-size: .82rem; color: var(--text); font-family: var(--mono); }
    .leg-item { display: flex; align-items: center; gap: 8px; }
    .leg-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }

    /* ── age bars ── */
    .age-bars { display: flex; flex-direction: column; gap: .5rem; }
    .age-row { display: flex; align-items: center; gap: .6rem; font-size: .78rem; }
    .age-key { width: 42px; color: var(--muted); font-family: var(--mono); font-size: .68rem; }
    .age-bar-wrap { flex: 1; height: 10px; background: rgba(255,255,255,.07); border-radius: 10px; overflow: hidden; }
    .age-bar { height: 100%; border-radius: 10px; background: var(--blue); transition: width .6s ease; }
    .age-cnt { width: 28px; text-align: right; color: var(--muted); font-family: var(--mono); font-size: .68rem; }

    /* ── district bars ── */
    .dist-bars { display: flex; flex-direction: column; gap: .55rem; }
    .dist-row { display: flex; align-items: center; gap: .6rem; font-size: .78rem; }
    .dist-key { flex: 1; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .dist-bar-wrap { width: 90px; height: 8px; background: rgba(255,255,255,.07); border-radius: 8px; overflow: hidden; }
    .dist-bar { height: 100%; border-radius: 8px; background: var(--green); }
    .dist-cnt { width: 24px; text-align: right; color: var(--muted); font-family: var(--mono); font-size: .68rem; }


    /* ── comments by route ── */
    .cr-row { display: flex; align-items: center; justify-content: space-between; padding: .6rem 0; border-bottom: 1px solid var(--border); }
    .cr-row:last-child { border-bottom: none; }
    .cr-info { flex: 1; }
    .cr-name { font-size: .82rem; color: var(--text); }
    .cr-sub  { font-size: .68rem; color: var(--muted); }
    .cr-badge { font-family: var(--mono); font-size: .72rem; background: rgba(255,107,107,.15); color: var(--red); border: 1px solid rgba(255,107,107,.25); border-radius: 20px; padding: 2px 10px; min-width: 30px; text-align: center; }

    /* ── comment mini-bar ── */
    .cmt-bar-row { display: flex; align-items: center; gap: .5rem; font-size: .75rem; margin-bottom: .5rem; }
    .cmt-bar-lbl { width: 90px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: .7rem; }
    .cmt-bar-track { flex: 1; height: 8px; background: rgba(255,255,255,.07); border-radius: 8px; overflow: hidden; display: flex; }
    .cmt-pos { height: 100%; background: var(--green); border-radius: 8px 0 0 8px; }
    .cmt-neg { height: 100%; background: var(--red); border-radius: 0 8px 8px 0; }
    .cmt-tot { width: 24px; text-align: right; color: var(--muted); font-family: var(--mono); font-size: .65rem; }

    /* ── legend pills ── */
    .legend-row { display: flex; gap: 1rem; font-size: .78rem; color: var(--text); margin-bottom: .8rem; font-family: var(--mono); }
    .legend-pip { display: flex; align-items: center; gap: 6px; }
    .pip { width: 10px; height: 10px; border-radius: 2px; }

    /* ── export btn ── */
    .export-row { display: flex; justify-content: flex-end; margin-top: 1.4rem; }
    .btn-export { display: flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: .72rem; letter-spacing: .08em; background: rgba(245,166,35,.12); color: var(--primary); border: 1px solid rgba(245,166,35,.3); border-radius: 8px; padding: 9px 18px; cursor: pointer; text-decoration: none; transition: background .2s; }
    .btn-export:hover { background: rgba(245,166,35,.22); }

    /* ── empty state ── */
    .empty { color: var(--muted); font-size: .8rem; padding: 1.5rem 0; text-align: center; }

    @@media (max-width: 900px) { .two-col { grid-template-columns: 1fr; } .kpi-row { grid-template-columns: 1fr 1fr; } }
    @@media (max-width: 500px) { .kpi-row { grid-template-columns: 1fr; } .db-head { flex-direction: column; gap: .8rem; } }
</style>

<div class="db-wrap" id="dashWrap">

    <!-- ── HEADER ── -->
    <div class="db-head">
        <div>
            <div class="db-eyebrow">// Panel de control</div>
            <h1 class="db-title">Dashboard</h1>
            <p class="db-sub">Sistema de Transporte Público · Arequipa</p>
        </div>
        <div class="db-clock">
            <div class="db-time" id="dbTime">--:--</div>
            <div class="db-date" id="dbDate">-- --- ----</div>
        </div>
    </div>
    <div class="db-hr"></div>

    <!-- ── KPIs ── -->
    <div class="kpi-row">
        <div class="kpi k-blue">
            <div class="kpi-val">@totalUsuarios</div>
            <div class="kpi-lbl">👤 Usuarios reg.</div>
        </div>
        <div class="kpi k-green">
            <div class="kpi-val">@totalRutas</div>
            <div class="kpi-lbl">🚌 Rutas activas</div>
        </div>
        <div class="kpi k-amber">
            <div class="kpi-val">@totalComentarios</div>
            <div class="kpi-lbl">💬 Búsquedas totales</div>
        </div>
        <div class="kpi k-teal">
            <div class="kpi-val">@pctCobertura%</div>
            <div class="kpi-lbl">⭐ Cobertura</div>
        </div>
    </div>

    <!-- ── DEMANDA CIUDADANA ── -->
    <p class="sec-lbl">// Demanda ciudadana</p>
    <div class="two-col" style="margin-bottom:1.4rem">

        <!-- Top combinaciones buscadas -->
        <div class="card">
            <div class="card-title"><span></span> Top combinaciones O→D</div>
            @if (topRutas == null || ((IEnumerable<dynamic>)topRutas).Count() == 0)
            {
                <div class="empty">Sin datos de búsquedas aún</div>
            }
            else
            {
                @foreach (var r in (IEnumerable<dynamic>)topRutas)
                {
                    <div class="route-row">
                        <span class="route-lbl">@r.Origen → @r.Destino</span>
                        <span class="route-cnt">@r.Contador</span>
                    </div>
                }
            }
        </div>

        <!-- Rutas sin cobertura -->
        <div class="card">
            <div class="card-title"><span style="background:var(--red)"></span> Zonas sin cobertura</div>
            @{
                var sinCob = topRutas != null
                    ? ((IEnumerable<dynamic>)topRutas)
                        .Where(r => (int)r.Contador < 5)
                        .ToList()
                    : new List<dynamic>();
            }
            @if (!sinCob.Any())
            {
                <div class="empty">Búsqueda con resultado de ruta</div>
            }
            else
            {
                @foreach (var r in sinCob)
                {
                    <div class="route-row">
                        <span class="route-lbl">@r.Origen → @r.Destino</span>
                        <span class="route-cnt" style="color:var(--red)">@r.Contador</span>
                    </div>
                }
            }
        </div>
    </div>

    <!-- ── MÓDULO USUARIOS ── -->
    <p class="sec-lbl">// Módulo usuarios</p>
    <div class="two-col" style="margin-bottom:1.4rem">

        <!-- Donut género -->
        <div class="card">
            <div class="card-title"><span style="background:var(--purple)"></span> Por género</div>
            @if (genTotal == 0)
            {
                <div class="empty">Sin datos de género</div>
            }
            else
            {
                <div class="donut-wrap">
                    <svg class="donut-svg" width="100" height="100" viewBox="0 0 100 100">
                        <circle cx="50" cy="50" r="@svgR" fill="none" stroke="rgba(255,255,255,.08)" stroke-width="14"/>
                        @if (genMasc > 0)
                        {
                            <circle cx="50" cy="50" r="@svgR" fill="none" stroke="#4A9EFF" stroke-width="14"
                                stroke-dasharray="@((circ * pMasc / 100).ToString("F1")) @circ.ToString("F1")"
                                stroke-dashoffset="@(circ * 0.25)" transform="rotate(-90 50 50)" />
                        }
                        @if (genFem > 0)
                        {
                            <circle cx="50" cy="50" r="@svgR" fill="none" stroke="#FF6B9D" stroke-width="14"
                                stroke-dasharray="@((circ * pFem / 100).ToString("F1")) @circ.ToString("F1")"
                                stroke-dashoffset="@(circ * (0.25 - pMasc / 100.0))" transform="rotate(-90 50 50)" />
                        }
                        @if (genOtro > 0)
                        {
                            <circle cx="50" cy="50" r="@svgR" fill="none" stroke="#B388FF" stroke-width="14"
                                stroke-dasharray="@((circ * pOtro / 100).ToString("F1")) @circ.ToString("F1")"
                                stroke-dashoffset="@(circ * (0.25 - (pMasc + pFem) / 100.0))" transform="rotate(-90 50 50)" />
                        }
                        <text x="50" y="54" text-anchor="middle" font-family="Space Mono,monospace" font-size="10" fill="#F0EDE8">@genTotal</text>
                    </svg>
                    <div class="donut-legend">
                        <div class="leg-item"><span class="leg-dot" style="background:#4A9EFF"></span> M: @pMasc%</div>
                        <div class="leg-item"><span class="leg-dot" style="background:#FF6B9D"></span> F: @pFem%</div>
                        @if (genOtro > 0){ <div class="leg-item"><span class="leg-dot" style="background:#B388FF"></span> Otro: @pOtro%</div> }
                    </div>
                </div>
            }
        </div>

        <!-- Barras edad -->
        <div class="card">
            <div class="card-title"><span style="background:var(--blue)"></span> Por edad</div>
            @if (!porEdad.Any() || porEdad.Values.Sum() == 0)
            {
                <div class="empty">Sin datos de edad</div>
            }
            else
            {
                <div class="age-bars">
                    @foreach (var item in porEdad)
                    {
                        <div class="age-row">
                            <span class="age-key">@item.Key</span>
                            <div class="age-bar-wrap">
                                <div class="age-bar" style="width: @(edadMax > 0 ? (item.Value * 100 / edadMax) : 0)%"></div>
                            </div>
                            <span class="age-cnt">@item.Value</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- ── DISTRIBUCIÓN GEOGRÁFICA ── -->
    <p class="sec-lbl">// Distribución geográfica</p>
    <div style="margin-bottom:1.4rem">
        <div class="card">
            <div class="card-title"><span style="background:var(--green)"></span> Top distritos de origen</div>
            @if (!porDistrito.Any())
            {
                <div class="empty">Sin datos de distrito</div>
            }
            else
            {
                <div class="dist-bars">
                    @foreach (var item in porDistrito)
                    {
                        <div class="dist-row">
                            <span class="dist-key">@item.Key</span>
                            <div class="dist-bar-wrap">
                                <div class="dist-bar" style="width: @(distMax > 0 ? (item.Value * 100 / distMax) : 0)%"></div>
                            </div>
                            <span class="dist-cnt">@item.Value</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- ── RUTAS Y COMUNIDAD ── -->
    <p class="sec-lbl">// Rutas y comunidad</p>
    <div class="two-col" style="margin-bottom:1.4rem">

        <!-- Rutas con más comentarios negativos -->
        <div class="card">
            <div class="card-title"><span style="background:var(--red)"></span> Rutas con más negativos</div>
            @if (comentPorRuta == null || !((IEnumerable<dynamic>)comentPorRuta).Any())
            {
                <div class="empty">Sin comentarios registrados</div>
            }
            else
            {
                @foreach (var c in (IEnumerable<dynamic>)comentPorRuta)
                {
                    <div class="cr-row">
                        <div class="cr-info">
                            <div class="cr-name">@c.NombreRuta</div>
                            <div class="cr-sub">Total: @c.Total comentarios</div>
                        </div>
                        <span class="cr-badge">@c.Negativos</span>
                    </div>
                }
            }
        </div>

        <!-- Comentarios por tipo y ruta -->
        <div class="card">
            <div class="card-title"><span style="background:var(--green)"></span> Comentarios por tipo y ruta</div>
            <div class="legend-row">
                <div class="legend-pip"><span class="pip" style="background:var(--green)"></span> Destacados</div>
<div class="legend-pip"><span class="pip" style="background:var(--muted)"></span> Normales</div>
            </div>
            @if (comentPorRuta == null || !((IEnumerable<dynamic>)comentPorRuta).Any())
            {
                <div class="empty">Sin datos</div>
            }
            else
            {
                @foreach (var c in (IEnumerable<dynamic>)comentPorRuta)
                {
                    int tot = (int)c.Total;
                    int pos = (int)c.Positivos;
                    int neg = (int)c.Negativos;
                    int pPos = tot > 0 ? pos * 100 / tot : 0;
                    int pNeg = tot > 0 ? neg * 100 / tot : 0;
                    <div class="cmt-bar-row">
                        <span class="cmt-bar-lbl">@c.NombreRuta</span>
                        <div class="cmt-bar-track">
                            <div class="cmt-pos" style="width:@pPos%"></div>
                            <div class="cmt-neg" style="width:@pNeg%"></div>
                        </div>
                        <span class="cmt-tot">@tot</span>
                    </div>
                }
            }
        </div>
    </div>

    <!-- ── EXPORT ── -->
    <div class="export-row">
        <a href="#" class="btn-export" onclick="exportarPDF(event)">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M2 10v2h10v-2M7 1v8M4 6l3 3 3-3"/>
            </svg>
            ↓ Exportar reporte PDF
        </a>
    </div>

</div>

<script>
    // ── reloj ──
    (function () {
        const dias   = ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'];
        const meses  = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
        function tick() {
            const now = new Date();
            const h = String(now.getHours()).padStart(2,'0');
            const m = String(now.getMinutes()).padStart(2,'0');
            document.getElementById('dbTime').textContent = h + ':' + m;
            document.getElementById('dbDate').textContent =
                dias[now.getDay()] + ', ' + now.getDate() + ' ' + meses[now.getMonth()] + ' ' + now.getFullYear();
        }
        tick(); setInterval(tick, 30000);
    })();

    // ── export PDF ──
    function exportarPDF(e) {
        e.preventDefault();
        window.print();
    }
</script>