@model IEnumerable<TuProyecto.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary:    #F5A623;
        --bg:         #0D0D1A;
        --surface:    rgba(255,255,255,0.05);
        --surface-hv: rgba(255,255,255,0.08);
        --border:     rgba(255,255,255,0.09);
        --text:       #F0EDE8;
        --muted:      rgba(240,237,232,0.48);
        --danger:     #FF6B6B;
        --info:       #4A9EFF;
        --font-mono:  'Space Mono', monospace;
        --font-main:  'Sora', sans-serif;
    }

    .page-wrap {
        max-width: 1260px;
        margin: 0 auto;
        padding: 2.5rem 2rem 4rem;
    }

    /* ── header ── */
    .page-header {
        display: flex; align-items: flex-end; justify-content: space-between;
        margin-bottom: 2rem;
        opacity: 0;
        animation: fadeUp .45s ease forwards .05s;
    }
    .page-eyebrow {
        font-family: var(--font-mono);
        font-size: .65rem; letter-spacing: .16em; text-transform: uppercase;
        color: var(--primary); margin-bottom: .4rem;
        display: flex; align-items: center; gap: 7px;
    }
    .eyebrow-dot {
        width: 5px; height: 5px; border-radius: 50%;
        background: var(--primary);
        animation: blink 1.4s ease-in-out infinite;
    }
    @@keyframes blink { 0%,100%{opacity:1;} 50%{opacity:.2;} }

    .page-title {
        font-family: var(--font-mono);
        font-size: 1.7rem; font-weight: 700;
        color: var(--text); margin: 0;
    }
    .page-count {
        font-size: .8rem; color: var(--muted); margin-top: .3rem;
        font-family: var(--font-mono);
    }
    .page-count span { color: var(--primary); }

    /* ── divider ── */
    .page-divider {
        height: 1px;
        background: linear-gradient(90deg, var(--primary), transparent);
        margin-bottom: 1.8rem;
        opacity: 0;
        animation: fadeUp .35s ease forwards .15s;
    }

    /* ── search ── */
    .search-row {
        display: flex; gap: .75rem; align-items: center;
        margin-bottom: 1.75rem;
        opacity: 0;
        animation: fadeUp .4s ease forwards .2s;
    }
    .search-wrap { position: relative; flex: 1; }
    .search-icon {
        position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
        color: var(--muted); pointer-events: none; font-size: .9rem;
    }
    .search-input {
        width: 100%; padding: 11px 14px 11px 40px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        color: var(--text); font-family: var(--font-mono); font-size: .82rem;
        outline: none; transition: border-color .2s, background .2s;
    }
    .search-input::placeholder { color: rgba(240,237,232,.22); }
    .search-input:focus { border-color: var(--primary); background: rgba(245,166,35,.05); }

    .btn-search {
        display: inline-flex; align-items: center; gap: 6px;
        background: var(--surface); border: 1px solid var(--border);
        border-radius: 10px; padding: 11px 18px;
        color: var(--text); font-family: var(--font-mono); font-size: .78rem;
        cursor: pointer; text-decoration: none; white-space: nowrap;
        transition: border-color .2s, background .2s, color .2s;
    }
    .btn-search:hover { border-color: var(--primary); color: var(--primary); background: rgba(245,166,35,.07); }

    .btn-clear {
        display: inline-flex; align-items: center; gap: 6px;
        background: transparent; border: 1px solid var(--border);
        border-radius: 10px; padding: 11px 16px;
        color: var(--muted); font-family: var(--font-mono); font-size: .78rem;
        cursor: pointer; text-decoration: none; white-space: nowrap;
        transition: border-color .2s, color .2s;
    }
    .btn-clear:hover { border-color: rgba(255,107,107,.4); color: var(--danger); }

    /* ── table ── */
    .table-wrap {
        border: 1px solid var(--border);
        border-radius: 14px; overflow: hidden;
        opacity: 0;
        animation: fadeUp .5s ease forwards .3s;
    }
    .data-table { width: 100%; border-collapse: collapse; font-size: .82rem; }

    .data-table thead {
        background: rgba(255,255,255,.04);
        border-bottom: 1px solid var(--border);
    }
    .data-table thead th {
        padding: 13px 16px;
        font-family: var(--font-mono);
        font-size: .62rem; letter-spacing: .12em; text-transform: uppercase;
        color: var(--muted); font-weight: 400; text-align: left; white-space: nowrap;
    }
    .data-table tbody tr {
        border-bottom: 1px solid var(--border);
        transition: background .15s;
    }
    .data-table tbody tr:last-child { border-bottom: none; }
    .data-table tbody tr:hover { background: var(--surface-hv); }
    .data-table td { padding: 13px 16px; color: var(--text); vertical-align: middle; }

    /* user cell */
    .user-cell { display: flex; align-items: center; gap: 10px; }
    .user-avatar {
        width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0;
        background: linear-gradient(135deg, rgba(245,166,35,.3), rgba(245,166,35,.1));
        border: 1px solid rgba(245,166,35,.25);
        display: flex; align-items: center; justify-content: center;
        font-family: var(--font-mono); font-size: .75rem; font-weight: 700;
        color: var(--primary);
    }
    .user-name { font-weight: 600; color: var(--text); }

    /* email */
    .cell-email { font-family: var(--font-mono); font-size: .75rem; color: var(--muted); }

    /* fecha */
    .cell-fecha { font-family: var(--font-mono); font-size: .73rem; color: var(--muted); white-space: nowrap; }

    /* genero badge */
    .badge-genero {
        display: inline-block;
        font-family: var(--font-mono); font-size: .62rem; letter-spacing: .07em; text-transform: uppercase;
        border-radius: 20px; padding: 3px 10px;
    }
    .badge-m { background: rgba(74,158,255,.1); border: 1px solid rgba(74,158,255,.25); color: #4A9EFF; }
    .badge-f { background: rgba(255,107,182,.1); border: 1px solid rgba(255,107,182,.25); color: #FF6BB6; }
    .badge-nd { background: var(--surface); border: 1px solid var(--border); color: var(--muted); }

    /* edad */
    .cell-edad { font-family: var(--font-mono); font-size: .78rem; color: var(--text); }
    .edad-zero { color: var(--muted); }

    /* distrito */
    .badge-distrito {
        display: inline-block;
        font-size: .75rem; color: var(--muted);
        background: var(--surface); border: 1px solid var(--border);
        border-radius: 6px; padding: 3px 10px;
        font-family: var(--font-mono); font-size: .7rem;
    }

    /* row num */
    .cell-num { font-family: var(--font-mono); font-size: .62rem; color: rgba(255,255,255,.15); text-align: center; width: 32px; }

    /* actions */
    .actions-cell { white-space: nowrap; text-align: right; }
    .btn-action {
        display: inline-flex; align-items: center; gap: 5px;
        font-family: var(--font-mono); font-size: .68rem; letter-spacing: .04em;
        border-radius: 7px; padding: 6px 12px;
        border: 1px solid; cursor: pointer; text-decoration: none;
        transition: background .18s, color .18s, border-color .18s;
    }
    .btn-action + .btn-action { margin-left: .4rem; }
    .btn-action svg { width: 11px; height: 11px; flex-shrink: 0; }

    .btn-info {
        color: var(--info);
        border-color: rgba(74,158,255,.3);
        background: rgba(74,158,255,.07);
    }
    .btn-info:hover { background: rgba(74,158,255,.18); border-color: rgba(74,158,255,.6); color: var(--info); }

    .btn-danger-sm {
        color: var(--danger);
        border-color: rgba(255,107,107,.3);
        background: rgba(255,107,107,.07);
    }
    .btn-danger-sm:hover { background: rgba(255,107,107,.18); border-color: rgba(255,107,107,.6); color: var(--danger); }

    /* empty */
    .empty-state { text-align: center; padding: 4rem 2rem; color: var(--muted); }
    .empty-icon { font-size: 2.5rem; margin-bottom: 1rem; opacity: .5; }
    .empty-title { font-family: var(--font-mono); font-size: .85rem; }

    @@keyframes fadeUp {
        from { opacity:0; transform:translateY(14px); }
        to   { opacity:1; transform:translateY(0); }
    }

    @@media (max-width: 900px) {
        .col-fecha, .col-distrito { display: none; }
    }
</style>

<div class="page-wrap">

    <!-- header -->
    <div class="page-header">
        <div>
            <div class="page-eyebrow">
                <span class="eyebrow-dot"></span> Módulo de acceso
            </div>
            <h1 class="page-title">Usuarios</h1>
            <p class="page-count">
                <span>@Model.Count()</span> usuarios registrados
                @if (!string.IsNullOrEmpty(ViewBag.Buscar as string))
                {
                    <text> · filtrando por "<span>@ViewBag.Buscar</span>"</text>
                }
            </p>
        </div>
    </div>

    <div class="page-divider"></div>

    <!-- search -->
    <form method="get" action="/Usuario/Index" class="search-row">
        <div class="search-wrap">
            <span class="search-icon">🔍</span>
            <input class="search-input" type="text" name="buscar"
                   value="@ViewBag.Buscar"
                   placeholder="Buscar por nombre o email..." />
        </div>
        <button type="submit" class="btn-search">
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.6">
                <circle cx="5.5" cy="5.5" r="4"/><path d="M9 9l3 3"/>
            </svg>
            Buscar
        </button>
        @if (!string.IsNullOrEmpty(ViewBag.Buscar as string))
        {
            <a href="/Usuario/Index" class="btn-clear">✕ Limpiar</a>
        }
    </form>

    <!-- table -->
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width:32px; text-align:center;">#</th>
                    <th>Usuario</th>
                    <th>Email</th>
                    <th class="col-fecha">Fecha Registro</th>
                    <th>Género</th>
                    <th>Edad</th>
                    <th class="col-distrito">Distrito</th>
                    <th style="text-align:right;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8">
                            <div class="empty-state">
                                <div class="empty-icon">👤</div>
                                <div class="empty-title">No se encontraron usuarios</div>
                            </div>
                        </td>
                    </tr>
                }
                @{ int rowNum = 1; }
                @foreach (var usuario in Model)
                {
                    string inicial = string.IsNullOrEmpty(usuario.Nombre) ? "?" : usuario.Nombre.Substring(0, 1).ToUpper();
                    string generoBadgeClass = usuario.Genero == "Masculino" ? "badge-m" : (usuario.Genero == "Femenino" ? "badge-f" : "badge-nd");
                    string generoLabel = string.IsNullOrEmpty(usuario.Genero) ? "N/D" : usuario.Genero;

                    <tr>
                        <td class="cell-num">@(rowNum++)</td>
                        <td>
                            <div class="user-cell">
                                <div class="user-avatar">@inicial</div>
                                <span class="user-name">@usuario.Nombre</span>
                            </div>
                        </td>
                        <td class="cell-email">@usuario.Email</td>
                        <td class="cell-fecha col-fecha">@usuario.FechaRegistro.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="badge-genero @generoBadgeClass">@generoLabel</span>
                        </td>
                        <td class="cell-edad">
                            @if (usuario.Edad == 0)
                            {
                                <span class="edad-zero">—</span>
                            }
                            else
                            {
                                @usuario.Edad
                            }
                        </td>
                        <td class="col-distrito">
                            @if (!string.IsNullOrEmpty(usuario.Distrito))
                            {
                                <span class="badge-distrito">@usuario.Distrito</span>
                            }
                            else
                            {
                                <span style="color:var(--muted); font-family:var(--font-mono); font-size:.72rem;">—</span>
                            }
                        </td>
                        <td class="actions-cell">
                            <a href="/Usuario/Perfil/@usuario.Id" class="btn-action btn-info">
                                <svg viewBox="0 0 11 11" fill="none" stroke="currentColor" stroke-width="1.6">
                                    <circle cx="5.5" cy="3.5" r="2"/>
                                    <path d="M1 10c0-2.5 2-4 4.5-4s4.5 1.5 4.5 4"/>
                                </svg>
                                Ver perfil
                            </a>
                            <a href="/Usuario/Eliminar/@usuario.Id"
                               class="btn-action btn-danger-sm"
                               onclick="return confirm('¿Eliminar al usuario @usuario.Nombre?')">
                                <svg viewBox="0 0 11 11" fill="none" stroke="currentColor" stroke-width="1.6">
                                    <path d="M1 3h9M4 3V2h3v1M2 3l.5 7h6L9 3"/>
                                </svg>
                                Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
