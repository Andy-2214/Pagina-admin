@model TuProyecto.Models.Usuario

@{
    ViewData["Title"] = "Perfil de Usuario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary:    #F5A623;
        --bg:         #0D0D1A;
        --surface:    rgba(255,255,255,0.05);
        --surface-hv: rgba(255,255,255,0.08);
        --border:     rgba(255,255,255,0.09);
        --text:       #F0EDE8;
        --muted:      rgba(240,237,232,0.48);
        --danger:     #FF6B6B;
        --info:       #4A9EFF;
        --success:    #3DD68C;
        --font-mono:  'Space Mono', monospace;
        --font-main:  'Sora', sans-serif;
    }

    .page-wrap {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2.5rem 2rem 4rem;
    }

    /* ── breadcrumb ── */
    .breadcrumb-row {
        display: flex; align-items: center; gap: 6px;
        font-family: var(--font-mono); font-size: .68rem;
        color: var(--muted); margin-bottom: 1.5rem;
        opacity: 0;
        animation: fadeUp .4s ease forwards .05s;
    }
    .breadcrumb-row a { color: var(--muted); text-decoration: none; transition: color .2s; }
    .breadcrumb-row a:hover { color: var(--primary); }
    .breadcrumb-row span { color: var(--text); }

    /* ── page header ── */
    .page-header {
        margin-bottom: 2rem;
        opacity: 0;
        animation: fadeUp .45s ease forwards .1s;
    }
    .page-eyebrow {
        font-family: var(--font-mono);
        font-size: .65rem; letter-spacing: .16em; text-transform: uppercase;
        color: var(--primary); margin-bottom: .4rem;
        display: flex; align-items: center; gap: 7px;
    }
    .eyebrow-dot {
        width: 5px; height: 5px; border-radius: 50%;
        background: var(--primary);
        animation: blink 1.4s ease-in-out infinite;
    }
    @@keyframes blink { 0%,100%{opacity:1;} 50%{opacity:.2;} }
    .page-title {
        font-family: var(--font-mono);
        font-size: 1.7rem; font-weight: 700;
        color: var(--text); margin: 0;
    }

    .page-divider {
        height: 1px;
        background: linear-gradient(90deg, var(--primary), transparent);
        margin-bottom: 2rem;
        opacity: 0;
        animation: fadeUp .35s ease forwards .15s;
    }

    /* ── layout grid ── */
    .profile-grid {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 1.5rem;
        align-items: start;
    }

    /* ── profile card ── */
    .profile-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px; overflow: hidden;
        opacity: 0;
        animation: fadeUp .5s ease forwards .2s;
    }

    .profile-card-top {
        padding: 2rem 1.5rem 1.5rem;
        text-align: center;
        border-bottom: 1px solid var(--border);
        background: rgba(255,255,255,.02);
    }
    .profile-avatar-lg {
        width: 72px; height: 72px; border-radius: 50%;
        background: linear-gradient(135deg, rgba(245,166,35,.35), rgba(245,166,35,.1));
        border: 2px solid rgba(245,166,35,.3);
        display: flex; align-items: center; justify-content: center;
        font-family: var(--font-mono); font-size: 1.6rem; font-weight: 700;
        color: var(--primary);
        margin: 0 auto 1rem;
    }
    .profile-name {
        font-family: var(--font-mono); font-size: 1rem; font-weight: 700;
        color: var(--text); margin-bottom: .3rem;
    }
    .profile-email {
        font-family: var(--font-mono); font-size: .72rem; color: var(--muted);
    }

    .profile-card-body { padding: 1.25rem 1.5rem; }

    .info-row {
        display: flex; align-items: center; justify-content: space-between;
        padding: .65rem 0;
        border-bottom: 1px solid rgba(255,255,255,.05);
    }
    .info-row:last-of-type { border-bottom: none; }
    .info-label {
        font-family: var(--font-mono); font-size: .65rem; letter-spacing: .1em;
        text-transform: uppercase; color: var(--muted);
    }
    .info-value {
        font-family: var(--font-mono); font-size: .78rem; color: var(--text);
        text-align: right;
    }
    .info-value.muted { color: var(--muted); }

    /* genero badge inline */
    .badge-genero {
        font-family: var(--font-mono); font-size: .62rem; letter-spacing: .07em;
        text-transform: uppercase; border-radius: 20px; padding: 3px 10px;
    }
    .badge-m { background: rgba(74,158,255,.1); border: 1px solid rgba(74,158,255,.25); color: #4A9EFF; }
    .badge-f { background: rgba(255,107,182,.1); border: 1px solid rgba(255,107,182,.25); color: #FF6BB6; }
    .badge-nd { background: var(--surface); border: 1px solid var(--border); color: var(--muted); }

    .profile-card-footer {
        padding: 1rem 1.5rem;
        border-top: 1px solid var(--border);
        display: flex; gap: .6rem;
        background: rgba(255,255,255,.02);
    }

    .btn-action {
        display: inline-flex; align-items: center; gap: 6px;
        font-family: var(--font-mono); font-size: .72rem; letter-spacing: .04em;
        border-radius: 8px; padding: 9px 14px;
        border: 1px solid; cursor: pointer; text-decoration: none;
        transition: background .18s, color .18s, border-color .18s;
        flex: 1; justify-content: center;
    }
    .btn-action svg { width: 12px; height: 12px; flex-shrink: 0; }

    .btn-back {
        color: var(--muted); border-color: var(--border); background: rgba(255,255,255,.04);
    }
    .btn-back:hover { border-color: rgba(255,255,255,.2); color: var(--text); background: rgba(255,255,255,.08); }

    .btn-danger-sm {
        color: var(--danger); border-color: rgba(255,107,107,.3); background: rgba(255,107,107,.07);
    }
    .btn-danger-sm:hover { background: rgba(255,107,107,.18); border-color: rgba(255,107,107,.6); color: var(--danger); }

    /* ── comments panel ── */
    .comments-panel {
        opacity: 0;
        animation: fadeUp .5s ease forwards .3s;
    }

    .section-header {
        display: flex; align-items: center; gap: 10px; margin-bottom: 1.2rem;
    }
    .section-icon {
        width: 30px; height: 30px; border-radius: 8px;
        background: rgba(255,255,255,.06); border: 1px solid var(--border);
        display: flex; align-items: center; justify-content: center; font-size: .85rem;
    }
    .section-title { font-family: var(--font-mono); font-size: .85rem; font-weight: 700; color: var(--text); }
    .section-badge {
        font-family: var(--font-mono); font-size: .62rem; letter-spacing: .08em;
        background: var(--surface); border: 1px solid var(--border);
        border-radius: 20px; padding: 3px 10px; color: var(--muted);
    }

    .table-wrap {
        border: 1px solid var(--border);
        border-radius: 14px; overflow: hidden;
    }
    .data-table { width: 100%; border-collapse: collapse; font-size: .82rem; }
    .data-table thead {
        background: rgba(255,255,255,.04); border-bottom: 1px solid var(--border);
    }
    .data-table thead th {
        padding: 12px 16px;
        font-family: var(--font-mono); font-size: .62rem; letter-spacing: .12em;
        text-transform: uppercase; color: var(--muted); font-weight: 400; text-align: left;
    }
    .data-table tbody tr {
        border-bottom: 1px solid var(--border); transition: background .15s;
    }
    .data-table tbody tr:last-child { border-bottom: none; }
    .data-table tbody tr:hover { background: var(--surface-hv); }
    .data-table td { padding: 12px 16px; color: var(--text); vertical-align: middle; }

    .badge-ruta {
        font-family: var(--font-mono); font-size: .7rem; font-weight: 700;
        color: var(--primary); background: rgba(245,166,35,.1);
        border: 1px solid rgba(245,166,35,.25); border-radius: 6px; padding: 3px 10px;
        white-space: nowrap;
    }
    .cell-texto { font-size: .82rem; color: var(--text); line-height: 1.55; }
    .cell-fecha { font-family: var(--font-mono); font-size: .72rem; color: var(--muted); white-space: nowrap; }
    .cell-num { font-family: var(--font-mono); font-size: .62rem; color: rgba(255,255,255,.15); text-align: center; width: 32px; }

    /* empty */
    .empty-state {
        text-align: center; padding: 3.5rem 2rem;
        border: 1px solid var(--border); border-radius: 14px;
        color: var(--muted);
    }
    .empty-icon { font-size: 2rem; margin-bottom: .75rem; opacity: .4; }
    .empty-title { font-family: var(--font-mono); font-size: .8rem; }

    @@keyframes fadeUp {
        from { opacity:0; transform:translateY(14px); }
        to   { opacity:1; transform:translateY(0); }
    }

    @@media (max-width: 860px) {
        .profile-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="page-wrap">

    <!-- breadcrumb -->
    <div class="breadcrumb-row">
        <a href="/Usuario/Index">Usuarios</a>
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.4">
            <path d="M3 2l4 3-4 3"/>
        </svg>
        <span>@Model.Nombre</span>
    </div>

    <!-- header -->
    <div class="page-header">
        <div class="page-eyebrow"><span class="eyebrow-dot"></span> Módulo de acceso</div>
        <h1 class="page-title">Perfil de Usuario</h1>
    </div>

    <div class="page-divider"></div>

    <div class="profile-grid">

        <!-- LEFT: profile card -->
        <div class="profile-card">
            <div class="profile-card-top">
                <div class="profile-avatar-lg">
                    @(string.IsNullOrEmpty(Model.Nombre) ? "?" : Model.Nombre.Substring(0,1).ToUpper())
                </div>
                <div class="profile-name">@Model.Nombre</div>
                <div class="profile-email">@Model.Email</div>
            </div>

            <div class="profile-card-body">
                <div class="info-row">
                    <span class="info-label">Género</span>
                    @if (!string.IsNullOrEmpty(Model.Genero))
                    {
                        string gc = Model.Genero == "Masculino" ? "badge-m" : (Model.Genero == "Femenino" ? "badge-f" : "badge-nd");
                        <span class="badge-genero @gc">@Model.Genero</span>
                    }
                    else
                    {
                        <span class="info-value muted">—</span>
                    }
                </div>
                <div class="info-row">
                    <span class="info-label">Edad</span>
                    @if (Model.Edad > 0)
                    {
                        <span class="info-value">@Model.Edad años</span>
                    }
                    else
                    {
                        <span class="info-value muted">—</span>
                    }
                </div>
                <div class="info-row">
                    <span class="info-label">Distrito</span>
                    @if (!string.IsNullOrEmpty(Model.Distrito))
                    {
                        <span class="info-value">@Model.Distrito</span>
                    }
                    else
                    {
                        <span class="info-value muted">—</span>
                    }
                </div>
                <div class="info-row">
                    <span class="info-label">Registro</span>
                    <span class="info-value">@Model.FechaRegistro.ToString("dd/MM/yyyy")</span>
                </div>
            </div>

            <div class="profile-card-footer">
                <a href="/Usuario/Index" class="btn-action btn-back">
                    <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6">
                        <path d="M8 2L4 6l4 4"/>
                    </svg>
                    Volver
                </a>
                <a href="/Usuario/Eliminar/@Model.Id"
                   class="btn-action btn-danger-sm"
                   onclick="return confirm('¿Eliminar la cuenta de @Model.Nombre?')">
                    <svg viewBox="0 0 11 11" fill="none" stroke="currentColor" stroke-width="1.6">
                        <path d="M1 3h9M4 3V2h3v1M2 3l.5 7h6L9 3"/>
                    </svg>
                    Eliminar cuenta
                </a>
            </div>
        </div>

        <!-- RIGHT: comments -->
        <div class="comments-panel">
            @{
                var comentarios = (IEnumerable<dynamic>)ViewBag.Comentarios;
                int totalComentarios = comentarios.Count();
            }

            <div class="section-header">
                <div class="section-icon">💬</div>
                <span class="section-title">Comentarios publicados</span>
                <span class="section-badge">@totalComentarios</span>
            </div>

            @if (totalComentarios == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon">💬</div>
                    <div class="empty-title">Este usuario no ha publicado comentarios</div>
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="width:32px; text-align:center;">#</th>
                                <th>Ruta</th>
                                <th>Comentario</th>
                                <th>Fecha</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int rowNum = 1; }
                            @foreach (var comentario in comentarios)
                            {
                                <tr>
                                    <td class="cell-num">@(rowNum++)</td>
                                    <td><span class="badge-ruta">@comentario.RutaId</span></td>
                                    <td class="cell-texto">@comentario.Texto</td>
                                    <td class="cell-fecha">@comentario.Fecha.ToString("dd/MM/yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>
</div>
