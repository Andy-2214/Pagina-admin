@model TuProyecto.Models.PromptIA

@{
    ViewData["Title"] = "Prompt IA";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary:    #F5A623;
        --bg:         #0D0D1A;
        --surface:    rgba(255,255,255,0.05);
        --surface-hv: rgba(255,255,255,0.08);
        --border:     rgba(255,255,255,0.09);
        --text:       #F0EDE8;
        --muted:      rgba(240,237,232,0.48);
        --success:    #3DD68C;
        --font-mono:  'Space Mono', monospace;
        --font-main:  'Sora', sans-serif;
    }

    .page-wrap {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2.5rem 2rem 4rem;
    }

    .page-header {
        margin-bottom: 2rem;
        opacity: 0;
        animation: fadeUp .45s ease forwards .05s;
    }
    .page-eyebrow {
        font-family: var(--font-mono);
        font-size: .65rem; letter-spacing: .16em; text-transform: uppercase;
        color: var(--primary); margin-bottom: .4rem;
        display: flex; align-items: center; gap: 7px;
    }
    .eyebrow-dot {
        width: 5px; height: 5px; border-radius: 50%;
        background: var(--primary);
        animation: blink 1.4s ease-in-out infinite;
    }
    @@keyframes blink { 0%,100%{opacity:1;} 50%{opacity:.2;} }

    .page-title {
        font-family: var(--font-mono);
        font-size: 1.7rem; font-weight: 700;
        color: var(--text); margin: 0;
    }

    .page-divider {
        height: 1px;
        background: linear-gradient(90deg, var(--primary), transparent);
        margin-bottom: 2rem;
        opacity: 0;
        animation: fadeUp .35s ease forwards .15s;
    }

    /* ── editor card ── */
    .editor-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 2.5rem;
        opacity: 0;
        animation: fadeUp .5s ease forwards .2s;
    }

    .editor-card-header {
        display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .75rem;
        padding: 1.2rem 1.6rem;
        border-bottom: 1px solid var(--border);
        background: rgba(255,255,255,.03);
    }
    .editor-card-title { display: flex; align-items: center; gap: 10px; }
    .editor-icon {
        width: 34px; height: 34px; border-radius: 9px;
        background: rgba(245,166,35,.12);
        border: 1px solid rgba(245,166,35,.25);
        display: flex; align-items: center; justify-content: center;
        font-size: 1rem; flex-shrink: 0;
    }
    .editor-title-text { font-family: var(--font-mono); font-size: .85rem; font-weight: 700; color: var(--text); }
    .editor-title-sub  { font-family: var(--font-mono); font-size: .63rem; color: var(--muted); margin-top: 2px; }

    .editor-meta {
        display: flex; align-items: center; gap: 8px;
        font-family: var(--font-mono); font-size: .68rem; color: var(--muted);
        background: rgba(255,255,255,.04);
        border: 1px solid var(--border);
        border-radius: 8px; padding: 6px 12px;
    }
    .meta-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--success); flex-shrink: 0; }

    .editor-body { padding: 1.5rem 1.6rem; }

    .prompt-textarea {
        width: 100%; min-height: 180px;
        background: rgba(0,0,0,.25);
        border: 1px solid var(--border);
        border-radius: 10px;
        color: var(--text);
        font-family: var(--font-mono); font-size: .82rem; line-height: 1.7;
        padding: 14px 16px;
        resize: vertical; outline: none;
        transition: border-color .2s, background .2s;
    }
    .prompt-textarea:focus {
        border-color: var(--primary);
        background: rgba(245,166,35,.04);
    }
    .textarea-hint {
        font-family: var(--font-mono); font-size: .65rem; color: var(--muted);
        margin-top: .5rem; display: flex; align-items: center; gap: 5px;
    }

    .editor-footer {
        display: flex; align-items: center; justify-content: space-between;
        padding: 1rem 1.6rem;
        border-top: 1px solid var(--border);
        background: rgba(255,255,255,.02);
    }
    .char-count { font-family: var(--font-mono); font-size: .68rem; color: var(--muted); }
    .char-count span { color: var(--primary); }

    .btn-save {
        display: inline-flex; align-items: center; gap: 8px;
        background: var(--success);
        color: #0a1a10; font-family: var(--font-mono);
        font-size: .78rem; font-weight: 700; letter-spacing: .05em;
        padding: 11px 22px; border-radius: 9px;
        border: none; cursor: pointer;
        transition: background .18s, transform .15s;
    }
    .btn-save:hover { background: #5be8a0; }
    .btn-save:active { transform: scale(.97); }
    .btn-save svg { width: 13px; height: 13px; }

    /* ── historial ── */
    .section-header {
        display: flex; align-items: center; gap: 10px;
        margin-bottom: 1.2rem;
        opacity: 0;
        animation: fadeUp .4s ease forwards .35s;
    }
    .section-icon {
        width: 30px; height: 30px; border-radius: 8px;
        background: rgba(255,255,255,.06);
        border: 1px solid var(--border);
        display: flex; align-items: center; justify-content: center;
        font-size: .85rem;
    }
    .section-title { font-family: var(--font-mono); font-size: .85rem; font-weight: 700; color: var(--text); }
    .section-badge {
        font-family: var(--font-mono); font-size: .62rem; letter-spacing: .08em;
        background: var(--surface); border: 1px solid var(--border);
        border-radius: 20px; padding: 3px 10px; color: var(--muted);
    }

    .table-wrap {
        border: 1px solid var(--border);
        border-radius: 14px; overflow: hidden;
        opacity: 0;
        animation: fadeUp .5s ease forwards .4s;
    }
    .data-table { width: 100%; border-collapse: collapse; font-size: .82rem; }
    .data-table thead {
        background: rgba(255,255,255,.04);
        border-bottom: 1px solid var(--border);
    }
    .data-table thead th {
        padding: 12px 16px;
        font-family: var(--font-mono);
        font-size: .62rem; letter-spacing: .12em; text-transform: uppercase;
        color: var(--muted); font-weight: 400; text-align: left;
    }
    .data-table tbody tr {
        border-bottom: 1px solid var(--border);
        transition: background .15s;
    }
    .data-table tbody tr:last-child { border-bottom: none; }
    .data-table tbody tr:hover { background: var(--surface-hv); }
    .data-table td { padding: 12px 16px; color: var(--text); vertical-align: middle; }

    .cell-num { font-family: var(--font-mono); font-size: .62rem; color: rgba(255,255,255,.15); text-align: center; width: 32px; }
    .cell-fecha { font-family: var(--font-mono); font-size: .73rem; color: var(--muted); white-space: nowrap; }
    .autor-chip { display: inline-flex; align-items: center; gap: 6px; }
    .autor-avatar {
        width: 22px; height: 22px; border-radius: 50%;
        background: rgba(255,255,255,.07); border: 1px solid var(--border);
        display: flex; align-items: center; justify-content: center;
        font-size: .6rem; color: var(--muted); font-family: var(--font-mono); flex-shrink: 0;
    }
    .cell-autor { font-family: var(--font-mono); font-size: .73rem; color: var(--text); }
    .cell-prompt { font-family: var(--font-mono); font-size: .75rem; color: var(--muted); max-width: 400px; line-height: 1.5; }

    .btn-restore {
        display: inline-flex; align-items: center; gap: 5px;
        font-family: var(--font-mono); font-size: .68rem; letter-spacing: .04em;
        color: var(--primary);
        border: 1px solid rgba(245,166,35,.3);
        background: rgba(245,166,35,.07);
        border-radius: 7px; padding: 6px 13px;
        text-decoration: none; white-space: nowrap;
        transition: background .18s, border-color .18s;
    }
    .btn-restore:hover { background: rgba(245,166,35,.18); border-color: rgba(245,166,35,.6); color: var(--primary); }
    .btn-restore svg { width: 11px; height: 11px; }

    .empty-state { text-align: center; padding: 3rem 2rem; color: var(--muted); }
    .empty-icon { font-size: 2rem; margin-bottom: .75rem; opacity: .4; }
    .empty-title { font-family: var(--font-mono); font-size: .8rem; }

    @@keyframes fadeUp {
        from { opacity:0; transform:translateY(14px); }
        to   { opacity:1; transform:translateY(0); }
    }
</style>

<div class="page-wrap">

    <div class="page-header">
        <div class="page-eyebrow"><span class="eyebrow-dot"></span> Inteligencia Artificial</div>
        <h1 class="page-title">Prompt IA</h1>
    </div>

    <div class="page-divider"></div>

    <!-- editor -->
    <div class="editor-card">
        <div class="editor-card-header">
            <div class="editor-card-title">
                <div class="editor-icon">🤖</div>
                <div>
                    <div class="editor-title-text">Prompt Activo</div>
                    <div class="editor-title-sub">Configuración del asistente IA</div>
                </div>
            </div>
            <div class="editor-meta">
                <span class="meta-dot"></span>
                @Model.FechaModificacion.ToString("dd/MM/yyyy HH:mm") &nbsp;·&nbsp; @Model.Autor
            </div>
        </div>

        <form method="post" action="/PromptIA/Actualizar">
            <div class="editor-body">
                <textarea name="Texto" id="promptTextarea" class="prompt-textarea"
                          rows="8" required>@Model.Texto</textarea>
                <p class="textarea-hint">
                    ℹ El prompt define el comportamiento del asistente de transporte público.
                </p>
            </div>
            <div class="editor-footer">
                <div class="char-count"><span id="charCount">@Model.Texto.Length</span> caracteres</div>
                <button type="submit" class="btn-save">
                    <svg viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M2 7l3 3 6-6"/>
                    </svg>
                    Guardar cambios
                </button>
            </div>
        </form>
    </div>

    <!-- historial -->
    @{
        var historial = (IEnumerable<dynamic>)ViewBag.Historial;
        int totalVersiones = historial.Count();
    }

    <div class="section-header">
        <div class="section-icon">📋</div>
        <span class="section-title">Historial de versiones</span>
        <span class="section-badge">@totalVersiones versiones</span>
    </div>

    <div class="table-wrap">
        @if (totalVersiones == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">🕐</div>
                <div class="empty-title">No hay versiones anteriores</div>
            </div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width:32px; text-align:center;">#</th>
                        <th>Fecha</th>
                        <th>Autor</th>
                        <th>Prompt</th>
                        <th style="text-align:right;">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rowNum = 1; }
                    @foreach (var version in historial)
                    {
                        string inicialAutor = string.IsNullOrEmpty((string)version.Autor) ? "?" : version.Autor.ToString().Substring(0, 1).ToUpper();
                        string textoCorto = version.Texto.Length > 100 ? version.Texto.Substring(0, 100) + "…" : version.Texto;
                        <tr>
                            <td class="cell-num">@(rowNum++)</td>
                            <td class="cell-fecha">@version.FechaModificacion.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="cell-autor">
                                <div class="autor-chip">
                                    <div class="autor-avatar">@inicialAutor</div>
                                    @version.Autor
                                </div>
                            </td>
                            <td class="cell-prompt">@textoCorto</td>
                            <td style="text-align:right;">
                                <a href="/PromptIA/Restaurar/@version.Id"
                                   class="btn-restore"
                                   onclick="return confirm('¿Restaurar esta versión del prompt?')">
                                    <svg viewBox="0 0 11 11" fill="none" stroke="currentColor" stroke-width="1.6">
                                        <path d="M1.5 5.5A4 4 0 1 1 3 8.6M1.5 3v2.5H4"/>
                                    </svg>
                                    Restaurar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

</div>

<script>
    const ta = document.getElementById('promptTextarea');
    const cc = document.getElementById('charCount');
    ta.addEventListener('input', function () { cc.textContent = ta.value.length; });
</script>
