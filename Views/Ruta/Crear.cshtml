@model TuProyecto.Models.Ruta

<h2>Agregar Ruta</h2>

<form method="post" action="/Ruta/Crear">
    <div class="mb-3">
        <label>Código</label>
        <input type="text" name="Codigo" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Nombre</label>
        <input type="text" name="Nombre" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Color</label>
        <input type="color" name="Color" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Avenidas</label>
        <textarea name="Avenidas" class="form-control" rows="3"></textarea>
    </div>
    <button type="submit" class="btn btn-success">Guardar</button>
    <a href="/Ruta/Index" class="btn btn-secondary">Cancelar</a>
</form>