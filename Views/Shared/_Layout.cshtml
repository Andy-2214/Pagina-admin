<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Admin Transporte</title>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

    <style>
        *, *::before, *::after { box-sizing: border-box; }

        :root {
            --primary:    #F5A623;
            --primary-dk: #C87D0E;
            --bg:         #0D0D1A;
            --nav-bg:     rgba(10,10,22,0.92);
            --surface:    rgba(255,255,255,0.05);
            --border:     rgba(255,255,255,0.09);
            --text:       #F0EDE8;
            --muted:      rgba(240,237,232,0.48);
            --font-mono:  'Space Mono', monospace;
            --font-main:  'Sora', sans-serif;
        }

        html, body {
            background: var(--bg);
            font-family: var(--font-main);
            color: var(--text);
            min-height: 100vh;
            margin: 0;
        }

        /* ════════════════════════════════
           NAVBAR
        ════════════════════════════════ */
        .top-nav {
            position: sticky; top: 0; z-index: 50;
            background: var(--nav-bg);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border-bottom: 1px solid var(--border);
            height: 62px;
            display: flex; align-items: center;
            padding: 0 2rem;
            gap: 0;
        }

        /* subtle scanline at very top */
        .top-nav::before {
            content: '';
            position: absolute; top: 0; left: 0; right: 0; height: 1px;
            background: linear-gradient(90deg, transparent 0%, var(--primary) 40%, transparent 100%);
            opacity: .35;
        }

        /* brand */
        .nav-brand {
            display: flex; align-items: center; gap: 10px;
            text-decoration: none; margin-right: 2.5rem;
            flex-shrink: 0;
        }
        .nav-brand-icon {
            width: 34px; height: 34px;
            background: var(--primary);
            border-radius: 9px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }
        .nav-brand-text {
            font-family: var(--font-mono);
            font-size: .78rem; line-height: 1.25;
            color: var(--text); letter-spacing: .04em;
        }
        .nav-brand-text span { color: var(--primary); }

        /* separator */
        .nav-sep {
            width: 1px; height: 28px;
            background: var(--border);
            margin-right: 2rem; flex-shrink: 0;
        }

        /* links */
        .nav-links {
            display: flex; align-items: center; gap: .25rem;
            flex: 1;
        }
        .nav-link {
            display: flex; align-items: center; gap: 7px;
            padding: 6px 13px;
            border-radius: 8px;
            font-size: .8rem; letter-spacing: .02em;
            color: var(--muted);
            text-decoration: none;
            transition: color .18s, background .18s;
            white-space: nowrap;
            position: relative;
        }
        .nav-link .nl-icon { font-size: .95rem; line-height: 1; }
        .nav-link .nl-label { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .05em; }

        .nav-link:hover {
            color: var(--text);
            background: rgba(255,255,255,.06);
        }
        .nav-link.active {
            color: var(--primary);
            background: rgba(245,166,35,.08);
        }
        .nav-link.active::after {
            content: '';
            position: absolute; bottom: -1px; left: 13px; right: 13px;
            height: 2px; border-radius: 2px;
            background: var(--primary);
        }

        /* right side */
        .nav-right {
            display: flex; align-items: center; gap: .75rem;
            margin-left: auto; flex-shrink: 0;
        }

        /* status pill */
        .nav-status {
            display: flex; align-items: center; gap: 6px;
            font-family: var(--font-mono);
            font-size: .62rem; letter-spacing: .1em; text-transform: uppercase;
            color: #3DD68C;
            background: rgba(61,214,140,.08);
            border: 1px solid rgba(61,214,140,.2);
            border-radius: 20px; padding: 4px 12px;
        }
        .status-dot {
            width: 6px; height: 6px; border-radius: 50%;
            background: #3DD68C;
            animation: blink 1.4s ease-in-out infinite;
        }
        @@keyframes blink { 0%,100%{opacity:1;} 50%{opacity:.25;} }

        /* user chip */
        .nav-user {
            display: flex; align-items: center; gap: 8px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 24px; padding: 5px 14px 5px 6px;
            cursor: default;
        }
        .user-avatar {
            width: 26px; height: 26px; border-radius: 50%;
            background: var(--primary);
            display: flex; align-items: center; justify-content: center;
            font-family: var(--font-mono); font-size: .65rem; font-weight: 700;
            color: #0D0D1A;
        }
        .user-name {
            font-size: .75rem; color: var(--text); font-family: var(--font-mono);
        }

        /* logout btn */
        .nav-logout {
            display: flex; align-items: center; gap: 6px;
            font-family: var(--font-mono); font-size: .72rem; letter-spacing: .05em;
            color: var(--muted);
            background: transparent;
            border: 1px solid var(--border);
            border-radius: 8px; padding: 6px 14px;
            text-decoration: none; cursor: pointer;
            transition: color .18s, border-color .18s, background .18s;
        }
        .nav-logout:hover {
            color: #FF6B6B;
            border-color: rgba(255,107,107,.35);
            background: rgba(255,107,107,.07);
        }

        /* mobile toggle */
        .nav-toggle {
            display: none;
            background: none; border: 1px solid var(--border);
            border-radius: 8px; padding: 6px 10px;
            color: var(--muted); cursor: pointer; font-size: 1rem;
            margin-left: auto;
        }

        @@media (max-width: 900px) {
            .nav-links { display: none; }
            .nav-links.open {
                display: flex; flex-direction: column; align-items: flex-start;
                position: absolute; top: 62px; left: 0; right: 0;
                background: rgba(10,10,22,.97);
                border-bottom: 1px solid var(--border);
                padding: .75rem 1.5rem 1rem;
                gap: .25rem;
            }
            .nav-toggle { display: flex; }
            .nav-status { display: none; }
            .nav-sep { display: none; }
        }
        @@media (max-width: 560px) {
            .user-name { display: none; }
            .nav-user { padding: 5px 8px; }
        }
    </style>
</head>
<body>
@if (ViewData["HideNavbar"] == null)
{
<!-- ════ NAVBAR ════ -->
<nav class="top-nav" role="navigation" aria-label="Navegación principal">

    <!-- brand -->
    <a href="/" class="nav-brand">
        <div class="nav-brand-icon">🚌</div>
        <div class="nav-brand-text">ADMIN<br><span>TRANSPORTE</span></div>
    </a>

    <div class="nav-sep"></div>

    <!-- links -->
    <div class="nav-links" id="navLinks">
        <a href="/Ruta/Index"       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Ruta"       ? "active" : "")">
            <span class="nl-icon">🚌</span><span class="nl-label">Rutas</span>
        </a>
        <a href="/Comentario/Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Comentario" ? "active" : "")">
            <span class="nl-icon">💬</span><span class="nl-label">Comentarios</span>
        </a>
        <a href="/PromptIA/Index"   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PromptIA"   ? "active" : "")">
            <span class="nl-icon">🤖</span><span class="nl-label">Prompt IA</span>
        </a>
        <a href="/Usuario/Index"    class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Usuario"    ? "active" : "")">
            <span class="nl-icon">👤</span><span class="nl-label">Usuarios</span>
        </a>
        <a href="/Dashboard"        class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard"  ? "active" : "")">
            <span class="nl-icon">📊</span><span class="nl-label">Dashboard</span>
        </a>
    </div>

    <!-- right -->
    <div class="nav-right">
        <div class="nav-status">
            <span class="status-dot"></span> En línea
        </div>

        <div class="nav-user">
            <div class="user-avatar">AD</div>
            <span class="user-name">Admin</span>
        </div>

        <a href="/Auth/Logout" class="nav-logout">
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M5 1H2a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h3M9 9l3-3-3-3M12 6.5H5"/>
            </svg>
            Salir
        </a>

        <button class="nav-toggle" id="navToggle" aria-label="Menú">☰</button>
    </div>

</nav>
}
<!-- ════ CONTENT ════ -->
<main>
    @RenderBody()
</main>

<script>
    // mobile toggle
    document.getElementById('navToggle').addEventListener('click', function () {
        document.getElementById('navLinks').classList.toggle('open');
    });
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
